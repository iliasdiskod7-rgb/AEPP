{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Τοπική τράπεζα προτύπων διαγωνισμάτων ΑΕΠΠ",
  "description": "Τα αθροίσματα μονάδων και η μοναδικότητα κωδικών/αναγνωριστικών ελέγχονται επιπλέον από το LocalExamBank.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exams"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "exams": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topics",
          "keywords",
          "difficulty",
          "exam"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "keywords": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "difficulty": {
            "enum": [
              "Εύκολο",
              "Μεσαίο",
              "Αυξημένης Δυσκολίας"
            ]
          },
          "exam": {
            "$ref": "#/$defs/exam"
          }
        }
      }
    }
  },
  "$defs": {
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inputs",
        "expectedOutput"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedOutput": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "questionText",
        "glowCodeSnippet",
        "solutionText",
        "marks",
        "testCases"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[ΑΒΓΔ][1-9][0-9]*$"
        },
        "questionText": {
          "type": "string",
          "minLength": 1
        },
        "glowCodeSnippet": {
          "type": [
            "string",
            "null"
          ]
        },
        "solutionText": {
          "type": "string",
          "minLength": 1
        },
        "marks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "testCases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testCase"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "totalMarks",
        "questions"
      ],
      "properties": {
        "theme": {
          "enum": [
            "Θέμα Α",
            "Θέμα Β",
            "Θέμα Γ",
            "Θέμα Δ"
          ]
        },
        "totalMarks": {
          "const": 25
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "theme": {
                "enum": [
                  "Θέμα Γ",
                  "Θέμα Δ"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "questions": {
                "items": {
                  "properties": {
                    "testCases": {
                      "minItems": 2
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "durationMinutes",
        "sections"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "durationMinutes": {
          "const": 180
        },
        "sections": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/section"
                },
                {
                  "properties": {
                    "theme": {
                      "const": "Θέμα Α"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/section"
                },
                {
                  "properties": {
                    "theme": {
                      "const": "Θέμα Β"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/section"
                },
                {
                  "properties": {
                    "theme": {
                      "const": "Θέμα Γ"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/section"
                },
                {
                  "properties": {
                    "theme": {
                      "const": "Θέμα Δ"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      }
    }
  }
}
